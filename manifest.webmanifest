{
  "name": "Living Racetrack · Pit Wall",
  "short_name": "Pit Wall",
  "description": "An always-on animated motorsport display for your wall.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#07090d",
